---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';

// Card used in the filterable grid of the Projets page
interface Props {
  projet: CollectionEntry<'projets'>;
  index?: number;
}

const { projet, index = 0 } = Astro.props;
const p = projet.data;
---
<a class="card reveal" href={`/projets/${projet.id}/`} data-categories={p.categories.join('|')} style={`--d:${(index % 2) * 0.1}s`}>
  <ProjectVisual projet={projet} width={720} tag={p.statut ?? p.periode} />
  <div class="meta-row">
    <div>
      <span class="kicker">{p.categories.join(' · ')}</span>
      <h3>{p.titre}</h3>
      <p>{p.resume}</p>
    </div>
    <span class="go" aria-hidden="true">↗</span>
  </div>
</a>
