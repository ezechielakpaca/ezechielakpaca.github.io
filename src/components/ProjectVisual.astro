---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';

// Project visual: the cover image if there is one, otherwise up to three
// phone screens fanned out, otherwise a generated illustration.
interface Props {
  projet: CollectionEntry<'projets'>;
  width?: number;
  tag?: string;
  eager?: boolean;
}

const { projet, width = 900, tag, eager = false } = Astro.props;
const p = projet.data;
const fan = p.ecrans.slice(0, 3);
---
<div class:list={['visual', { 'has-cover': p.couleur, 'has-image': !p.couleur && p.image, 'has-screens': !p.couleur && !p.image && fan.length }]}>
  {tag && <span class="tag-float glass">{tag}</span>}
  {p.couleur ? (
    <Cover projet={projet} eager={eager} />
  ) : p.image ? (
    <Image src={p.image} alt={`Aperçu du projet ${p.titre}`} width={width} loading={eager ? 'eager' : 'lazy'} />
  ) : fan.length ? (
    <div class="fan" aria-hidden="true">
      {fan.map((e) => <Image src={e} alt="" width={Math.min(e.width, 600)} quality={90} class="phone" loading={eager ? 'eager' : 'lazy'} />)}
    </div>
  ) : (
    <div class="art" aria-hidden="true">
      <div class="glyph">
        {p.icone === 'code' && (
          <svg viewBox="0 0 72 72"><path d="M10 14 H62 V58 H10 Z" /><path d="M10 24 H62" /><path class="a" d="M22 36 L29 41 L22 46 M34 46 H48" /></svg>
        )}
        {p.icone === 'mobile' && (
          <svg viewBox="0 0 72 72"><rect x="22" y="8" width="28" height="56" rx="6" /><path d="M32 13 H40 M27 21 H45 M27 26 H39" /><path class="a" d="M29 33 H43 V47 H29 Z M33 37 H35 V39 H33 Z M37 41 H39 V43 H37 Z" /></svg>
        )}
        {p.icone === 'objet' && (
          <svg viewBox="0 0 72 72"><path d="M10 40 L44 30 C 52 28, 60 30, 62 34 L44 40 Z" /><path class="a" d="M44 40 L58 44 C 60 45, 60 48, 57 48 L40 46 Z" /></svg>
        )}
        {p.icone === 'web' && (
          <svg viewBox="0 0 72 72"><rect x="8" y="12" width="56" height="44" rx="4" /><path d="M8 22 H64" /><path class="a" d="M16 31 H40 M16 38 H34 M16 45 H46" /></svg>
        )}
        {p.icone === 'data' && (
          <svg viewBox="0 0 72 72"><ellipse cx="36" cy="16" rx="20" ry="7" /><path d="M16 16 V54 C16 62, 56 62, 56 54 V16" /><path class="a" d="M16 29 C16 37, 56 37, 56 29 M16 42 C16 50, 56 50, 56 42" /></svg>
        )}
      </div>
      <span class="word">{p.titre}</span>
    </div>
  )}
</div>
