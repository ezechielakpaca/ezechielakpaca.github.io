---
// Circuit board for the « À propos » section: a central chip wired to the four
// key figures. Light pulses travel along the traces and light up each figure.
interface Chiffre { valeur: string; unite: string; label: string }
interface Props { chiffres: Chiffre[] }
const { chiffres } = Astro.props;

// Main traces (chip → figure), in the same order as the figures
const traces = [
  'M270 200 V118 H226',
  'M330 200 V118 H374',
  'M270 320 V402 H226',
  'M330 320 V402 H374',
];
// Decorative traces ending on a via
const decor = [
  { d: 'M240 236 H150 V206', end: [150, 206] },
  { d: 'M240 284 H110 V330', end: [110, 330] },
  { d: 'M360 236 H450 V206', end: [450, 206] },
  { d: 'M360 284 H490 V330', end: [490, 330] },
  { d: 'M300 200 V44', end: [300, 44] },
  { d: 'M300 320 V476', end: [300, 476] },
  { d: 'M240 260 H40', end: [40, 260] },
  { d: 'M360 260 H560', end: [560, 260] },
];
// Chip pins
const pins = [0, 1, 2, 3, 4, 5].map((i) => 246 + i * 21.6);
---
<div class="circuit">
  <svg class="board" viewBox="0 0 600 520" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
    <defs>
      <pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1.5" cy="1.5" r="1.2" class="dot" /></pattern>
      <radialGradient id="chipGlow"><stop offset="0" class="glow-a" /><stop offset="1" class="glow-b" /></radialGradient>
    </defs>
    <rect width="600" height="520" fill="url(#dots)" />
    <circle cx="300" cy="260" r="150" fill="url(#chipGlow)" class="chip-halo" />

    {decor.map((t, i) => (
      <g>
        <path d={t.d} class="trace" pathLength="100" style={`--i:${i + 4}`} />
        <path d={t.d} class="pulse thin" pathLength="100" style={`--dur:${3.2 + (i % 3) * 0.7}s;--delay:${1.8 + i * 0.35}s`} />
        <circle cx={t.end[0]} cy={t.end[1]} r="5" class="via" />
      </g>
    ))}

    {traces.map((d, i) => (
      <g>
        <path d={d} class="trace main" pathLength="100" style={`--i:${i}`} />
        <path d={d} class="pulse" pathLength="100" style={`--dur:2.6s;--delay:${1.4 + i * 0.65}s`} />
      </g>
    ))}

    {pins.map((x) => (
      <g class="pins">
        <rect x={x - 2} y="188" width="4" height="12" rx="1" />
        <rect x={x - 2} y="320" width="4" height="12" rx="1" />
      </g>
    ))}
    {pins.slice(0, 5).map((_, i) => (
      <g class="pins">
        <rect x="228" y={226 + i * 17} width="12" height="4" rx="1" />
        <rect x="360" y={226 + i * 17} width="12" height="4" rx="1" />
      </g>
    ))}
  </svg>

  <div class="chip">
    <span class="chip-core">EA</span>
    <span class="chip-led" aria-hidden="true"></span>
  </div>

  {chiffres.slice(0, 4).map((c, i) => (
    <div class={`node node-${i + 1} glass`} style={`--delay:${1.4 + i * 0.65}s`}>
      <span class="node-led" aria-hidden="true"></span>
      <b>{c.valeur}<em>{c.unite}</em></b>
      <span class="node-label">{c.label}</span>
    </div>
  ))}
</div>
