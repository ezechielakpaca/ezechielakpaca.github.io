---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const articles = (await getCollection('blog', ({ data }) => !data.brouillon))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog" active="blog" description="Articles de Marie-Ezéchiel Akpaca sur le développement, le produit et l'UX.">
  <section class="page-head">
    <div class="wrap">
      <a class="back" href="/">← Accueil</a>
      <p class="eyebrow" style="margin-top:28px">Blog</p>
      <h1>Ce que j’<span class="accent">apprends</span> en chemin.</h1>
      <p class="intro">Notes sur le développement Java et web, la conception de produits et l’UX.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      {articles.length > 0 ? (
        <div class="posts">
          {articles.map((a, i) => (
            <a class="post reveal" href={`/blog/${a.id}/`} style={`--d:${(i % 3) * 0.08}s`}>
              <span class="meta"><time datetime={a.data.date.toISOString()}>{formatDate(a.data.date)}</time></span>
              <h3>{a.data.titre}</h3>
              <p>{a.data.description}</p>
              <span class="link-arrow">Lire l’article <span class="arr">↗</span></span>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">Le premier article arrive bientôt.</p>
      )}
    </div>
  </section>
</Base>
