---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const articles = (await getCollection('blog', ({ data }) => !data.brouillon))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog — développement, UX et produit" active="blog" description="Articles de Marie-Ezéchiel Akpaca, étudiant en L3 MIAGE à Lille, sur le développement Java, l’UX design et la conception de produits.">
  <section class="page-head">
    <div class="blob a" aria-hidden="true"></div>
    <div class="blob b" aria-hidden="true"></div>
    <div class="wrap">
      <span class="crumbs glass rise"><a href="/">Accueil</a> / Blog</span>
      <h1 class="rise" style="--d:.1s">Le <span class="accent">blog</span>.</h1>
      <p class="intro rise" style="--d:.2s">Développement, produit et UX.</p>
    </div>
  </section>
  <section class="section tight">
    <div class="wrap">
      {articles.length > 0 ? (
        <div class="posts">
          {articles.map((a, i) => (
            <a class="post reveal" href={`/blog/${a.id}/`} style={`--d:${(i % 3) * 0.08}s`}>
              <span class="meta"><time datetime={a.data.date.toISOString()}>{formatDate(a.data.date)}</time></span>
              <h3>{a.data.titre}</h3>
              <p>{a.data.description}</p>
              <span class="link-arrow">Lire <span class="arr">↗</span></span>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty glass">Le premier article arrive bientôt.</p>
      )}
    </div>
  </section>
</Base>
