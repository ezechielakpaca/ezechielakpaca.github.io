---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projets = (await getCollection('projets', ({ data }) => !data.brouillon))
  .sort((a, b) => a.data.ordre - b.data.ordre || b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Projets" active="projets" description="Projets de Marie-Ezéchiel Akpaca : développement Java et full-stack, produit numérique et UX.">
  <section class="page-head">
    <div class="wrap">
      <a class="back" href="/">← Accueil</a>
      <p class="eyebrow" style="margin-top:28px">Portfolio</p>
      <h1>Tous mes <span class="accent">projets</span>.</h1>
      <p class="intro">Développement et produit numérique. Chaque fiche détaille le contexte, ce que j’ai fait et les outils utilisés.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      {projets.length > 0 ? (
        <div class="works">{projets.map((p, i) => <ProjectCard projet={p} index={i} />)}</div>
      ) : (
        <p class="empty">Aucun projet publié pour l’instant.</p>
      )}
    </div>
  </section>
</Base>
