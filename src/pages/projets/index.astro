---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GridCard from '../../components/GridCard.astro';
import { ordreCategories } from '../../data/categories';

const projets = (await getCollection('projets', ({ data }) => !data.brouillon))
  .sort((a, b) => a.data.ordre - b.data.ordre || b.data.date.valueOf() - a.data.date.valueOf());

// Filters in a fixed order, only for categories that have projects
const compte = (c: string) => projets.filter((p) => (p.data.categories as string[]).includes(c)).length;
const domaines = ordreCategories.filter((c) => compte(c) > 0);
---
<Base title="Projets" active="projets" description="Projets UX design de Marie-Ezéchiel Akpaca : applications mobiles et web.">
  <section class="page-head">
    <div class="blob a" aria-hidden="true"></div>
    <div class="blob b" aria-hidden="true"></div>
    <div class="wrap">
      <span class="crumbs glass rise"><a href="/">Accueil</a> / Projets</span>
      <h1 class="rise" style="--d:.1s">Mes <span class="accent">projets</span>.</h1>
      <p class="intro rise" style="--d:.2s">Applications mobiles et web, du parcours à l’interface.</p>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      {projets.length > 0 ? (
        <>
          <div class="filters glass reveal" role="group" aria-label="Filtrer par catégorie">
            <button class="filter on" type="button" data-filter="*" aria-pressed="true">Tous <sup>{projets.length}</sup></button>
            {domaines.map((d) => (
              <button class="filter" type="button" data-filter={d} aria-pressed="false">{d} <sup>{compte(d)}</sup></button>
            ))}
          </div>
          <div class="grid" id="grid">
            {projets.map((p, i) => <GridCard projet={p} index={i} />)}
          </div>
        </>
      ) : (
        <p class="empty glass">Aucun projet publié pour l’instant.</p>
      )}
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
    const cards = document.querySelectorAll<HTMLElement>('#grid .card');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => { const on = b === btn; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
        cards.forEach((c) => c.classList.add('fading'));
        setTimeout(() => {
          cards.forEach((c) => {
            const show = f === '*' || (c.dataset.categories ?? '').split('|').includes(f ?? '');
            c.classList.toggle('hide', !show);
            c.classList.add('in');
          });
          requestAnimationFrame(() => requestAnimationFrame(() => cards.forEach((c) => c.classList.remove('fading'))));
        }, 250);
      });
    });
  </script>
</Base>
