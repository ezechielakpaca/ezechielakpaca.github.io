---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projets = (await getCollection('projets', ({ data }) => !data.brouillon))
  .sort((a, b) => a.data.ordre - b.data.ordre || b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Projets" active="projets" description="Projets de Marie-Ezéchiel Akpaca : développement Java et full-stack, produit numérique et design d'objet.">
  <section class="page-head">
    <div class="wrap">
      <a class="back" href="/">← Accueil</a>
      <h1>Projets</h1>
      <p class="intro">Développement, produit numérique et design d’objet. Chaque fiche détaille le contexte, ce que j’ai fait et les outils utilisés.</p>
    </div>
  </section>
  <section class="plate">
    <div class="wrap">
      {projets.length > 0 ? (
        <div class="projects">{projets.map((p) => <ProjectCard projet={p} />)}</div>
      ) : (
        <p class="empty">Aucun projet publié pour l’instant.</p>
      )}
    </div>
  </section>
</Base>
