---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import photo from '../assets/photo-profil.jpg';
import {
  profil, stage, experiences, competences, formation, certifications, langues, motsCles, chiffres, technos,
} from '../data/profil';

const projets = (await getCollection('projets', ({ data }) => !data.brouillon))
  .sort((a, b) => a.data.ordre - b.data.ordre || b.data.date.valueOf() - a.data.date.valueOf());
const enAvant = projets.filter((p) => p.data.enAvant);
const projetsAccueil = (enAvant.length ? enAvant : projets).slice(0, 4);

const articles = (await getCollection('blog', ({ data }) => !data.brouillon))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const pad = (n: number) => String(n + 1).padStart(2, '0');
---
<Base active="accueil" jsonld={[
  { '@context': 'https://schema.org', '@type': 'WebSite', name: profil.nom, url: Astro.site!.href, inLanguage: 'fr-FR', author: { '@id': new URL('/#personne', Astro.site).href } },
  { '@context': 'https://schema.org', '@type': 'ProfilePage', url: Astro.site!.href, inLanguage: 'fr-FR', mainEntity: { '@id': new URL('/#personne', Astro.site).href } },
]}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="blob a" aria-hidden="true"></div>
    <div class="blob b" aria-hidden="true"></div>
    <div class="wrap">
      <div>
        <p class="hello glass rise" style="--d:.05s"><span class="wave" aria-hidden="true">👋</span> Bonjour !</p>
        <h1 class="rise" style="--d:.15s">Je suis Marie&#8209;Ezéchiel <span class="accent">Akpaca</span></h1>
        <p class="role rise" style="--d:.28s">Développeur <span class="typed" id="typed">Java / Spring Boot</span></p>
        <p class="intro rise" style="--d:.4s">Étudiant en L3 MIAGE à Lille. Je cherche un stage de 12 semaines dès le 19 avril 2027.</p>
        <div class="hero-cta rise" style="--d:.52s">
          <a class="btn btn-fill" href="/contact/">Me contacter <span class="arr">↗</span></a>
          <a class="btn btn-line" href="/cv/CV_Marie-Ezechiel_Akpaca.pdf" download>Télécharger mon CV <svg class="dl" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v10M5.5 8.5 10 13l4.5-4.5M4 16h12" /></svg></a>
          <a class="badge-rot" href="#a-propos" aria-label="Défiler vers la présentation">
            <svg class="ring" viewBox="0 0 112 112" aria-hidden="true">
              <defs><path id="circ" d="M56,56 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
              <text><textPath href="#circ">Stage · avril 2027 · Lille ·</textPath></text>
            </svg>
            <span class="core glass"><svg viewBox="0 0 20 20"><path d="M10 3v14M4 11l6 6 6-6" /></svg></span>
          </a>
        </div>
      </div>

      <div class="hero-photo rise" style="--d:.2s">
        <div class="orbit" aria-hidden="true"></div>
        <div class="disc"><Image src={photo} alt={`Portrait de ${profil.nom}`} width={460} loading="eager" /></div>
        <div class="chip c1 glass"><i aria-hidden="true" class="devicon-java-plain"></i><div>Java / Spring Boot<small>1 an en banque</small></div></div>
        <div class="chip c2 glass"><span class="cal" aria-hidden="true"><b>avr.</b><i>19</i></span><div>Début du stage<small>12 semaines · Lille</small></div></div>
        <span class="hand-note" aria-hidden="true">c’est moi&nbsp;!
          <svg viewBox="0 0 90 60"><path d="M6 8 C 30 6, 58 18, 70 44" /><path d="M58 40 L 71 46 L 74 32" /></svg>
        </span>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <span>
          {motsCles.map((m, i) => (
            <>
              <span class={i % 2 ? 'outline' : undefined}>{m}</span>
              <span class="sep" aria-hidden="true"></span>
            </>
          ))}
        </span>
      ))}
    </div>
  </div>

  <!-- ============ ABOUT ============ -->
  <section class="section" id="a-propos">
    <div class="wrap about">
      <div class="reveal">
        <p class="eyebrow">À propos</p>
        <p class="about-statement">Je comprends le <b>besoin</b>, je dessine le <b>parcours</b>, puis je <b class="accent">code le produit</b>.</p>
        <p class="about-text">Backend Java en banque, UX d’une application de microcrédit, gestion de produit : je fais le lien entre utilisateurs et développeurs.</p>
      </div>
      <div class="stats-wrap reveal" style="--d:.15s">
        <div class="blob a" aria-hidden="true"></div>
        <div class="blob b" aria-hidden="true"></div>
        <div class="stats">
          {chiffres.map((c) => (
            <div class="stat glass"><b>{c.valeur}<em>{c.unite}</em></b><span>{c.label}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STAGE ============ -->
  <section class="section tight" id="stage">
    <div class="wrap">
      <div class="stage-card reveal">
        <div>
          <p class="eyebrow">Stage recherché</p>
          <h2>12 semaines dès le 19 avril 2027.</h2>
          <ul class="missions">{stage.missions.map((m) => <li>{m}</li>)}</ul>
        </div>
        <dl class="fiche">
          {stage.fiche.map((f) => (
            <div><dt>{f.cle}</dt><dd>{f.valeur}{f.note && <small>{f.note}</small>}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ PROJETS ============ -->
  <section class="section tight" id="projets">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Projets</p>
          <h2><b>Projets</b> sélectionnés.</h2>
        </div>
        <a class="btn btn-line" href="/projets/">Tous les projets <span class="arr">↗</span></a>
      </div>
      <div class="works">
        {projetsAccueil.map((p, i) => <ProjectCard projet={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ============ PARCOURS ============ -->
  <section class="section tight" id="parcours">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Expériences</p>
          <h2>Mon <b>parcours</b>.</h2>
        </div>
        <a class="btn btn-line" href="/parcours/">Tout le parcours <span class="arr">↗</span></a>
      </div>
      <ol class="timeline">
        {experiences.map((e, i) => (
          <li class="job reveal" style={`--d:${i * 0.08}s`}>
            <div class="when"><b>{e.quand}</b>{e.ou}</div>
            <div>
              <h3>{e.poste}</h3>
              <ul>{e.points.map((pt) => <li set:html={pt} />)}</ul>
              {e.tags.length > 0 && <div class="pills">{e.tags.map((t) => <span class="pill">{t}</span>)}</div>}
            </div>
            <span class="num" aria-hidden="true">{pad(i)}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ COMPÉTENCES ============ -->
  <section class="section tight" id="competences">
    <div class="wrap skills-zone">
      <div class="blob a" aria-hidden="true"></div>
      <div class="blob b" aria-hidden="true"></div>
      <div class="section-head center reveal" style="position:relative;z-index:1">
        <div>
          <p class="eyebrow">Compétences</p>
          <h2>Ma <b>stack</b>.</h2>
        </div>
      </div>
      <div class="capsules">
        {technos.map((t, i) => (
          <div class="capsule glass reveal" style={`--d:${i * 0.07}s`}>
            <span class="ico"><i class={t.icone} aria-hidden="true"></i></span>
            <b>{t.nom}</b>
          </div>
        ))}
      </div>
      <div class="skill-rows">
        {competences.map((c, i) => (
          <div class="skill-row reveal" style={`--d:${i * 0.07}s`}>
            <p class="eyebrow">{c.label}</p>
            <ul>{c.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FORMATION ============ -->
  <section class="section tight" id="formation">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Formation</p>
          <h2>Études & <b>certifications</b>.</h2>
        </div>
      </div>
      <div class="edu">
        <div class="panel reveal">
          <h3>Formation</h3>
          {formation.map((f) => (
            <div class="edu-item">
              <b>{f.titre}</b><span class="yr">{f.annees}</span>
              <span class="d">{f.lieu}</span>
              {f.note && <span class="note">{f.note}</span>}
            </div>
          ))}
        </div>
        <div class="panel reveal" style="--d:.12s">
          <h3>Certifications</h3>
          <ul class="certs">
            {certifications.map((c) => <li><span>{c.titre}</span><span>{c.source}</span></li>)}
          </ul>
          <div class="langs">{langues.map((l) => <span>{l}</span>)}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BLOG ============ -->
  {articles.length > 0 && (
    <section class="section tight" id="blog">
      <div class="wrap">
        <div class="section-head reveal">
          <div>
            <p class="eyebrow">Blog</p>
            <h2>Derniers <b>articles</b>.</h2>
          </div>
          <a class="btn btn-line" href="/blog/">Tous les articles <span class="arr">↗</span></a>
        </div>
        <div class="posts">
          {articles.map((a, i) => (
            <a class="post reveal" href={`/blog/${a.id}/`} style={`--d:${i * 0.08}s`}>
              <span class="meta"><time datetime={a.data.date.toISOString()}>{formatDate(a.data.date)}</time></span>
              <h3>{a.data.titre}</h3>
              <p>{a.data.description}</p>
              <span class="link-arrow">Lire <span class="arr">↗</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script>
    // Rotating role in the hero
    const el = document.getElementById('typed');
    const roles = ['Java / Spring Boot', 'full-stack', 'orienté produit & UX'];
    if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let i = 0;
      el.style.transition = 'opacity .35s, transform .35s';
      el.style.display = 'inline-block';
      setInterval(() => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(8px)';
        setTimeout(() => {
          i = (i + 1) % roles.length;
          el.textContent = roles[i];
          el.style.opacity = '1';
          el.style.transform = 'none';
        }, 350);
      }, 2800);
    }
  </script>
</Base>
