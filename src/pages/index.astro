---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import photo from '../assets/photo-profil.jpg';
import {
  profil, stage, experiences, competences, formation, certifications, langues, motsCles, chiffres, technos,
} from '../data/profil';

const projets = (await getCollection('projets', ({ data }) => !data.brouillon))
  .sort((a, b) => a.data.ordre - b.data.ordre || b.data.date.valueOf() - a.data.date.valueOf());
const enAvant = projets.filter((p) => p.data.enAvant);
const projetsAccueil = (enAvant.length ? enAvant : projets).slice(0, 4);

const articles = (await getCollection('blog', ({ data }) => !data.brouillon))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const pad = (n: number) => String(n + 1).padStart(2, '0');
---
<Base>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="hello rise" style="--d:.05s"><span class="wave" aria-hidden="true">👋</span> Bonjour !</p>
        <h1 class="rise" style="--d:.15s">Je suis Marie&#8209;Ezéchiel <span class="accent">Akpaca</span></h1>
        <p class="role rise" style="--d:.28s">Développeur <span class="typed" id="typed">Java / Spring Boot</span></p>
        <p class="intro rise" style="--d:.4s">
          Étudiant en L3 MIAGE à l’Université de Lille. Un an de backend sur un core banking system, puis la conception UX d’une application de microcrédit.
          Je cherche un stage de 12 semaines à partir du 19 avril 2027.
        </p>
        <div class="hero-cta rise" style="--d:.52s">
          <a class="btn btn-fill" href="#contact">Me proposer un stage <span class="arr">↗</span></a>
          <a class="btn btn-line" href="/projets/">Voir mes projets</a>
          <a class="badge-rot" href="#a-propos" aria-label="Défiler vers la présentation">
            <svg class="ring" viewBox="0 0 118 118" aria-hidden="true">
              <defs><path id="circ" d="M59,59 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs>
              <text><textPath href="#circ">Stage · avril 2027 · Disponible · Lille ·</textPath></text>
            </svg>
            <span class="core"><svg viewBox="0 0 20 20"><path d="M10 3v14M4 11l6 6 6-6" /></svg></span>
          </a>
        </div>
      </div>

      <div class="hero-photo rise" style="--d:.2s">
        <div class="orbit" aria-hidden="true"></div>
        <div class="disc"><Image src={photo} alt={`Portrait de ${profil.nom}`} width={460} loading="eager" /></div>
        <div class="chip c1"><i aria-hidden="true">☕</i><div>Java / Spring Boot<small>1 an en core banking</small></div></div>
        <div class="chip c2"><i aria-hidden="true">✦</i><div>Stage dès le 19.04.2027<small>12 semaines · Lille</small></div></div>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <span>
          {motsCles.map((m, i) => (
            <>
              <span class={i % 2 ? 'outline' : undefined}>{m}</span>
              <span class="star">✦</span>
            </>
          ))}
        </span>
      ))}
    </div>
  </div>

  <!-- ============ ABOUT ============ -->
  <section class="section" id="a-propos">
    <div class="wrap about">
      <div class="reveal">
        <p class="eyebrow">À propos</p>
        <p class="about-statement">Je comprends le <b>besoin métier</b>, je dessine le <b>parcours</b>, puis je <b class="accent">code le produit</b>.</p>
        <p class="about-text">
          Formé à l’informatique au Bénin (licence à l’IFRI) puis à Lille, j’ai travaillé sur des services bancaires en Java / Spring Boot avant de rejoindre l’équipe UX.
          Je suis aussi chef de produit digital chez Oranex Tech. Cette double pratique me permet de parler aussi bien aux développeurs qu’aux utilisateurs.
        </p>
      </div>
      <div class="stats reveal" style="--d:.15s">
        {chiffres.map((c) => (
          <div class="stat"><b>{c.valeur}<em> {c.unite}</em></b><span>{c.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ STAGE ============ -->
  <section class="section" id="stage" style="padding-top:0">
    <div class="wrap">
      <div class="stage-card reveal">
        <div>
          <p class="eyebrow">Stage recherché</p>
          <h2>12 semaines pour construire un vrai produit avec votre équipe.</h2>
          <p class="lead">Stage de fin de L3 MIAGE. Le développement en priorité, avec une dimension produit et utilisateur.</p>
          <ul class="missions">
            {stage.missions.map((m) => <li><b>{m.titre}</b><span>{m.detail}</span></li>)}
          </ul>
        </div>
        <dl class="fiche">
          {stage.fiche.map((f) => (
            <div><dt>{f.cle}</dt><dd>{f.valeur}{f.note && <small>{f.note}</small>}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ PROJETS ============ -->
  <section class="section" id="projets" style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Mes projets</p>
          <h2><b>Projets</b> sélectionnés.</h2>
        </div>
        <a class="btn btn-line" href="/projets/">Tous les projets <span class="arr">↗</span></a>
      </div>
      <div class="works">
        {projetsAccueil.map((p, i) => <ProjectCard projet={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ============ PARCOURS ============ -->
  <section class="section" id="parcours" style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Expériences</p>
          <h2>Mon <b>parcours</b>.</h2>
        </div>
        <p>Du backend bancaire à la conception d’interfaces, en passant par la gestion de produit.</p>
      </div>
      <ol class="timeline">
        {experiences.map((e, i) => (
          <li class="job reveal" style={`--d:${i * 0.08}s`}>
            <div class="when"><b>{e.quand}</b>{e.ou}</div>
            <div>
              <h3>{e.poste}</h3>
              <div class="org">{e.contexte}</div>
              <ul>{e.points.map((pt) => <li set:html={pt} />)}</ul>
              {e.tags.length > 0 && <div class="pills">{e.tags.map((t) => <span class="pill">{t}</span>)}</div>}
            </div>
            <span class="num" aria-hidden="true">{pad(i)}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ COMPÉTENCES ============ -->
  <section class="section" id="competences" style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal" style="justify-content:center;text-align:center">
        <div>
          <p class="eyebrow">Compétences</p>
          <h2>De la base de données <b>à l’écran</b>.</h2>
        </div>
      </div>
      <div class="capsules">
        {technos.map((t, i) => (
          <div class="capsule reveal" style={`--d:${i * 0.07}s`}>
            <span class="ico"><i class={t.icone} aria-hidden="true"></i></span>
            <b>{t.nom}</b>
            <span>{t.role}</span>
          </div>
        ))}
      </div>
      <div class="skill-groups">
        {competences.map((c, i) => (
          <div class="skill-group reveal" style={`--d:${(i % 3) * 0.08}s`}>
            <p class="eyebrow">{c.label}</p>
            <h3 style="margin-top:8px">{c.titre}</h3>
            <ul>{c.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FORMATION ============ -->
  <section class="section" id="formation" style="padding-top:0">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Formation</p>
          <h2>Études & <b>certifications</b>.</h2>
        </div>
      </div>
      <div class="edu">
        <div class="panel reveal">
          <h3>Formation</h3>
          {formation.map((f) => (
            <div class="edu-item">
              <b>{f.titre}</b><span class="yr">{f.annees}</span>
              <span class="d">{f.detail}</span>
              {f.note && <span class="note">{f.note}</span>}
            </div>
          ))}
        </div>
        <div class="panel reveal" style="--d:.12s">
          <h3>Certifications</h3>
          <ul class="certs">
            {certifications.map((c) => <li><span>{c.titre}</span><span>{c.source}</span></li>)}
          </ul>
          <div class="langs">{langues.map((l) => <span>{l}</span>)}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BLOG ============ -->
  {articles.length > 0 && (
    <section class="section" id="blog" style="padding-top:0">
      <div class="wrap">
        <div class="section-head reveal">
          <div>
            <p class="eyebrow">Blog</p>
            <h2>Derniers <b>articles</b>.</h2>
          </div>
          <a class="btn btn-line" href="/blog/">Tous les articles <span class="arr">↗</span></a>
        </div>
        <div class="posts">
          {articles.map((a, i) => (
            <a class="post reveal" href={`/blog/${a.id}/`} style={`--d:${i * 0.08}s`}>
              <span class="meta"><time datetime={a.data.date.toISOString()}>{formatDate(a.data.date)}</time></span>
              <h3>{a.data.titre}</h3>
              <p>{a.data.description}</p>
              <span class="link-arrow">Lire l’article <span class="arr">↗</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script>
    // Rotating role in the hero
    const el = document.getElementById('typed');
    const roles = ['Java / Spring Boot', 'full-stack', 'à l’esprit produit & UX'];
    if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let i = 0;
      el.style.transition = 'opacity .35s, transform .35s';
      el.style.display = 'inline-block';
      setInterval(() => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(8px)';
        setTimeout(() => {
          i = (i + 1) % roles.length;
          el.textContent = roles[i];
          el.style.opacity = '1';
          el.style.transform = 'none';
        }, 350);
      }, 2800);
    }
  </script>
</Base>
