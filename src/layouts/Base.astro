---
import '../styles/global.css';
import { profil } from '../data/profil';

interface Props {
  title?: string;
  description?: string;
  active?: 'accueil' | 'projets' | 'blog' | 'parcours' | 'contact';
  /** « article » pour les articles de blog */
  type?: 'website' | 'article';
  /** Données structurées propres à la page (JSON-LD) */
  jsonld?: Record<string, unknown>[];
}

const {
  title,
  description = 'Marie-Ezéchiel Akpaca, étudiant en L3 MIAGE à Lille, cherche un stage en informatique dès avril 2027 : développeur Java / Spring Boot, full-stack et UX designer.',
  active,
  type = 'website',
  jsonld = [],
} = Astro.props;

const site = Astro.site!;
const pageTitle = title
  ? `${title} · ${profil.nom}`
  : `${profil.nom} — Stagiaire développeur Java / full-stack & UX designer à Lille`;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og.png', site);
const annee = new Date().getFullYear();

// Identity shared by every page, so search engines link the site to the person
const personne = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#personne', site).href,
  name: profil.nom,
  alternateName: ['Ezéchiel Akpaca', 'Bidossessi Marie-Ezéchiel Akpaca'],
  url: site.href,
  image: new URL('/photo-profil.jpg', site).href,
  email: `mailto:${profil.email}`,
  jobTitle: 'Développeur Java / full-stack et UX designer, en recherche de stage',
  description: 'Étudiant en L3 MIAGE à l’Université de Lille, à la recherche d’un stage de 12 semaines à partir du 19 avril 2027 en développement Java / Spring Boot, full-stack ou UX design.',
  address: { '@type': 'PostalAddress', addressLocality: 'Lille', addressRegion: 'Hauts-de-France', addressCountry: 'FR' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Université de Lille' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'IFRI, Université d’Abomey-Calavi' },
    { '@type': 'EducationalOrganization', name: 'Lycée Théophile-Legrand' },
  ],
  knowsAbout: ['Java', 'Spring Boot', 'API REST', 'SQL', 'Vue.js', 'React', 'UX design', 'UI design', 'Figma', 'Analyse fonctionnelle', 'Développement full-stack'],
  sameAs: [profil.liens.linkedin, profil.liens.github, profil.liens.behance],
};
const schemas = [personne, ...jsonld];
---
<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profil.nom} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f3f7f6" id="theme-color" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={profil.nom} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profil.nom}, stagiaire développeur Java / full-stack et UX designer`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Apply the saved theme before the first paint (light by default) -->
    <script is:inline>
      (function () {
        var t = 'light';
        try { t = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light'; } catch (e) {}
        var r = document.documentElement;
        r.dataset.theme = t;
        r.classList.add('js');
        var m = document.getElementById('theme-color');
        if (m) m.setAttribute('content', t === 'dark' ? '#0b1110' : '#f3f7f6');
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/devicon@2.16.0/devicon.min.css" />
  </head>
  <body>
    <header class="nav" id="nav">
      <div class="nav-bar">
        <a class="logo" href="/" aria-label="Accueil"><span class="logo-mark">EA</span><span>Ezéchiel<span class="dot">.</span></span></a>
        <nav class="nav-links" id="nav-links" aria-label="Navigation">
          <a href="/" class={active === 'accueil' ? 'active' : undefined}>Accueil</a>
          <a href="/#a-propos">À propos</a>
          <a href="/projets/" class={active === 'projets' ? 'active' : undefined}>Projets</a>
          <a href="/blog/" class={active === 'blog' ? 'active' : undefined}>Blog</a>
          <a href="/contact/" class={active === 'contact' ? 'active' : undefined}>Contact</a>
        </nav>
        <div class="nav-actions">
          <button class="icon-btn theme-toggle" id="theme-toggle" type="button" aria-label="Passer en mode sombre">
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <a class="btn btn-fill" href="/contact/">Me contacter <span class="arr">↗</span></a>
          <button class="icon-btn burger" id="burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav-links">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9h14M5 15h14" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <section class="call" id="contact" aria-label="Contact">
      <div class="call-rows">
        <div class="call-row">
          {[0, 1].map(() => (
            <span class="it">
              <span class="big">Stage avril 2027</span><span class="star">✦</span>
              <span class="big ghost">Travaillons ensemble</span><span class="star">✦</span>
              <span class="big">Stage avril 2027</span><span class="star">✦</span>
              <span class="big ghost">Travaillons ensemble</span><span class="star">✦</span>
            </span>
          ))}
        </div>
        <div class="call-row rev">
          {[0, 1].map(() => (
            <span class="it">
              <a class="pill-big" href="/contact/">Me contacter</a><span class="star">✦</span>
              <a class="pill-big" href={profil.liens.linkedin} target="_blank" rel="noopener">LinkedIn</a><span class="star">✦</span>
              <a class="pill-big" href={profil.liens.github} target="_blank" rel="noopener">GitHub</a><span class="star">✦</span>
              <a class="pill-big" href="/contact/">Me contacter</a><span class="star">✦</span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <footer class="footer">
      <div class="blob a" aria-hidden="true"></div>
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a class="logo" href="/"><span class="logo-mark">EA</span><span>Ezéchiel<span class="dot">.</span></span></a>
            <p class="lead">Développeur Java / full-stack, L3 MIAGE à l’Université de Lille.</p>
          </div>
          <div>
            <h4>Contact</h4>
            <div class="mail-line">
              <span class="mail-addr" id="mail">{profil.email}</span>
              <button class="copy" id="copy-mail" type="button">Copier</button>
            </div>
            <p style="color:var(--fg-2);margin-top:8px">{profil.ville}</p>
          </div>
          <div>
            <h4>Pages</h4>
            <ul>
              <li><a href="/parcours/">Parcours</a></li>
              <li><a href="/projets/">Projets</a></li>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/contact/">Contact</a></li>
            </ul>
          </div>
          <div>
            <h4>Réseaux</h4>
            <div class="socials">
              <a href={profil.liens.github} target="_blank" rel="noopener" aria-label="GitHub"><i class="devicon-github-original"></i></a>
              <a href={profil.liens.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><i class="devicon-linkedin-plain"></i></a>
              <a href={profil.liens.behance} target="_blank" rel="noopener" aria-label="Behance"><i class="devicon-behance-plain"></i></a>
            </div>
          </div>
        </div>
        <div class="copyright">
          <span>© {annee} {profil.nom}</span>
          <span>Lille, France</span>
        </div>
      </div>
    </footer>

    <button class="to-top glass" id="to-top" type="button" aria-label="Revenir en haut">
      <svg class="prog" viewBox="0 0 50 50" aria-hidden="true"><circle class="bg" cx="25" cy="25" r="24"></circle><circle class="fg" id="prog" cx="25" cy="25" r="24"></circle></svg>
      <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg>
    </button>

    <script>
      const root = document.documentElement;
      const nav = document.getElementById('nav');

      // ----- Theme toggle -----
      const toggle = document.getElementById('theme-toggle');
      const meta = document.getElementById('theme-color');
      const setLabel = () => toggle?.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Passer en mode clair' : 'Passer en mode sombre');
      setLabel();
      const apply = (t: string) => {
        root.dataset.theme = t;
        meta?.setAttribute('content', t === 'dark' ? '#0b1110' : '#f3f7f6');
        try { localStorage.setItem('theme', t); } catch (e) {}
        setLabel();
      };
      toggle?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
        if (doc.startViewTransition && !reduce) {
          const r = toggle.getBoundingClientRect();
          const x = r.left + r.width / 2;
          const y = r.top + r.height / 2;
          const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          root.style.setProperty('--tx', `${x}px`);
          root.style.setProperty('--ty', `${y}px`);
          root.style.setProperty('--tr', `${radius}px`);
          doc.startViewTransition(() => apply(next));
        } else {
          root.classList.add('theme-fade');
          apply(next);
          setTimeout(() => root.classList.remove('theme-fade'), 400);
        }
      });

      // ----- Header glass on scroll + back-to-top progress -----
      const toTop = document.getElementById('to-top');
      const prog = document.getElementById('prog');
      const onScroll = () => {
        const y = window.scrollY;
        nav?.classList.toggle('scrolled', y > 20);
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = max > 0 ? Math.min(y / max, 1) : 0;
        if (prog) prog.style.strokeDashoffset = String(151 - 151 * ratio);
        toTop?.classList.toggle('show', y > 500);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      // ----- Mobile menu -----
      const burger = document.getElementById('burger');
      burger?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open') ?? false;
        burger.setAttribute('aria-expanded', String(open));
      });
      document.querySelectorAll('#nav-links a').forEach((a) =>
        a.addEventListener('click', () => { nav?.classList.remove('open'); burger?.setAttribute('aria-expanded', 'false'); }),
      );

      // ----- Reveal on scroll -----
      let pending = Array.from(document.querySelectorAll('.reveal'));
      let ticking = false;
      const reveal = () => {
        ticking = false;
        const limit = window.innerHeight * 0.92;
        pending = pending.filter((el) => {
          if (el.getBoundingClientRect().top < limit) { el.classList.add('in'); return false; }
          return true;
        });
        if (!pending.length) {
          window.removeEventListener('scroll', queue);
          window.removeEventListener('resize', queue);
        }
      };
      const queue = () => { if (!ticking) { ticking = true; requestAnimationFrame(reveal); } };
      window.addEventListener('scroll', queue, { passive: true });
      window.addEventListener('resize', queue);
      reveal();

      // ----- Copy e-mail -----
      const btn = document.getElementById('copy-mail');
      const addr = document.getElementById('mail');
      btn?.addEventListener('click', () => {
        const text = (addr?.textContent || '').trim();
        const done = (label: string) => { btn.textContent = label; setTimeout(() => { btn.textContent = 'Copier'; }, 2000); };
        if (navigator.clipboard) navigator.clipboard.writeText(text).then(() => done('Copié ✓'), () => done('Ctrl+C'));
        else done('Ctrl+C');
      });
    </script>
  </body>
</html>
